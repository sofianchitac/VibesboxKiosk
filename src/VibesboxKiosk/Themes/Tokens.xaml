<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:media="using:Microsoft.UI.Xaml.Media">

    <!-- Color Tokens -->
    <Color x:Key="BgPrimary">#000000</Color>
    <Color x:Key="BgSecondary">#141414</Color>
    <Color x:Key="BgCard">#1A1A1A</Color>
    <Color x:Key="TextPrimary">#FFFFFF</Color>
    <Color x:Key="TextSecondary">#E6E4E2</Color>
    <Color x:Key="TextMuted">#8B796B</Color>
    
    <Color x:Key="ColorOrange">#FF7049</Color>
    <Color x:Key="ColorOrangeLight">#FDA564</Color>
    <Color x:Key="ColorCyan">#59C2EB</Color>
    <Color x:Key="ColorRed">#FF4B4B</Color>

    <!-- Brushes -->
    <SolidColorBrush x:Key="BgPrimaryBrush" Color="{StaticResource BgPrimary}" />
    <SolidColorBrush x:Key="BgSecondaryBrush" Color="{StaticResource BgSecondary}" />
    <SolidColorBrush x:Key="BgCardBrush" Color="{StaticResource BgCard}" />
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimary}" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondary}" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource TextMuted}" />
    
    <SolidColorBrush x:Key="ColorOrangeBrush" Color="{StaticResource ColorOrange}" />
    <SolidColorBrush x:Key="ColorOrangeLightBrush" Color="{StaticResource ColorOrangeLight}" />
    <SolidColorBrush x:Key="ColorCyanBrush" Color="{StaticResource ColorCyan}" />
    <SolidColorBrush x:Key="ColorRedBrush" Color="{StaticResource ColorRed}" />

    <!-- Button State Brushes -->
    <SolidColorBrush x:Key="BtnIdleBrush" Color="#8B796B" />
    <SolidColorBrush x:Key="BtnOffBrush" Color="#141414" />
    <SolidColorBrush x:Key="BtnPlayingBrush" Color="#FF7049" />
    <SolidColorBrush x:Key="BtnActiveBrush" Color="#FFFFFF" />

    <!-- Spectrum Brushes -->
    <SolidColorBrush x:Key="SpectrumLineBrush" Color="{StaticResource ColorOrangeLight}" />
    <LinearGradientBrush x:Key="SpectrumFillBrush" StartPoint="0.5,0" EndPoint="0.5,1">
        <GradientStop Color="#FF8B796B" Offset="0" />
        <GradientStop Color="#008B796B" Offset="1" />
    </LinearGradientBrush>

    <!-- Effects & Glows -->
    <!-- Note: WinUI 3 Shadow handling is typically done via Attached Shadow or ThemeShadow in controls. -->

    <!-- Typography -->
    <FontFamily x:Key="PrimaryFontFamily">ms-appx:///Themes/Fonts/InstrumentSans-Regular.ttf#Instrument Sans</FontFamily>
    <FontFamily x:Key="PrimaryFontFamilyMedium">ms-appx:///Themes/Fonts/InstrumentSans-Medium.ttf#Instrument Sans</FontFamily>
    <FontFamily x:Key="PrimaryFontFamilyBold">ms-appx:///Themes/Fonts/InstrumentSans-Bold.ttf#Instrument Sans</FontFamily>

</ResourceDictionary>
