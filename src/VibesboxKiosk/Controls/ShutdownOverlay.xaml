<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="VibesboxKiosk.Controls.ShutdownOverlay"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Opacity="0"
    IsHitTestVisible="False">

    <!-- No backdrop — the page background is already black, and leaving this
         transparent lets the dashboard's BlackHole collapse remain visible
         behind the label during the shutdown grace period. -->
    <TextBlock x:Name="LabelText"
               Text="SHUTTING DOWN"
               FontFamily="{StaticResource PrimaryFontFamilyMedium}"
               FontSize="18"
               CharacterSpacing="300"
               Foreground="{StaticResource TextMutedBrush}"
               HorizontalAlignment="Center"
               VerticalAlignment="Center"/>
</UserControl>
