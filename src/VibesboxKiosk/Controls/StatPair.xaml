<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="VibesboxKiosk.Controls.StatPair"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Label and value on the same row, vertically centered -->
    <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
        <TextBlock x:Name="LabelText"
                   FontFamily="{StaticResource PrimaryFontFamilyMedium}"
                   FontSize="12"
                   CharacterSpacing="150"
                   Foreground="{StaticResource TextMutedBrush}"
                   VerticalAlignment="Center"/>
        <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
            <TextBlock x:Name="ValueText"
                       FontFamily="{StaticResource PrimaryFontFamilyBold}"
                       FontSize="16"
                       FontWeight="Bold"
                       Foreground="{StaticResource TextPrimaryBrush}"
                       VerticalAlignment="Center"/>
            <TextBlock x:Name="UnitText"
                       FontFamily="{StaticResource PrimaryFontFamily}"
                       FontSize="16"
                       Foreground="{StaticResource TextPrimaryBrush}"
                       VerticalAlignment="Center"/>
        </StackPanel>
    </StackPanel>
</UserControl>
