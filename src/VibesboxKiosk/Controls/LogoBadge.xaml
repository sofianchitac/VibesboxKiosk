<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="VibesboxKiosk.Controls.LogoBadge"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="Transparent">

    <!-- Height comes from the theme (LogoHeight); width follows each image's aspect.
         Top-anchored so "LogoBadge top == visible logo top". -->
    <Grid Background="Transparent" Tapped="OnTapped">
        <Image x:Name="GreyLogo" Stretch="Uniform" Opacity="1" IsHitTestVisible="False"
               VerticalAlignment="Top" HorizontalAlignment="Center"/>
        <Image x:Name="ColorLogo" Stretch="Uniform" Opacity="0" IsHitTestVisible="False"
               VerticalAlignment="Top" HorizontalAlignment="Center"/>
    </Grid>
</UserControl>
