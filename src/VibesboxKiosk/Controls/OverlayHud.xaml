<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="VibesboxKiosk.Controls.OverlayHud"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Opacity="0"
    IsHitTestVisible="False">

    <!-- Full-screen dark backdrop with acrylic tint -->
    <Border>
        <Border.Background>
            <AcrylicBrush TintColor="#FF000000" TintOpacity="0" FallbackColor="#FF000000"/>
        </Border.Background>

        <!-- Centered content — scales up + rises on show, recedes on hide.
             The full-screen backdrop only fades. -->
        <StackPanel Spacing="12"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    RenderTransformOrigin="0.5,0.5">
            <StackPanel.RenderTransform>
                <CompositeTransform x:Name="ContentTransform"/>
            </StackPanel.RenderTransform>
            <TextBlock x:Name="LabelText"
                       FontFamily="{StaticResource PrimaryFontFamily}"
                       FontSize="13"
                       CharacterSpacing="200"
                       Foreground="{StaticResource ColorOrangeBrush}"
                       HorizontalAlignment="Center"/>
            <TextBlock x:Name="ValueText"
                       FontFamily="{StaticResource PrimaryFontFamilyBold}"
                       FontSize="96"
                       FontWeight="Bold"
                       Foreground="{StaticResource TextMutedBrush}"
                       HorizontalAlignment="Center"
                       LineHeight="96"/>
        </StackPanel>
    </Border>
</UserControl>
