<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="VibesboxKiosk.Pages.DashboardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ctrl="using:VibesboxKiosk.Controls"
    Background="{StaticResource BgPrimaryBrush}"
    SizeChanged="Page_SizeChanged"
    Loaded="Page_Loaded"
    Unloaded="Page_Unloaded">

    <!-- Resolution independence: everything is laid out on a virtual canvas at
         least 1024×768 design pixels, stretched in whichever direction the screen
         is longer, and the Viewbox scales it to fill the window exactly (see
         Page_SizeChanged). Wider screens get wider buttons and spectrum, taller
         screens a taller spectrum; nothing is letterboxed. -->
    <Viewbox Stretch="Fill">
    <Grid x:Name="RootGrid" Width="1024" Height="768">
        <!-- Main Layout — wrapped so the shutdown blackHole animation can target the dashboard
             content without scaling/fading the overlays on top of it. -->
        <Grid x:Name="DashboardContent"
              Padding="40"
              RenderTransformOrigin="0.5,0.5">
            <Grid.RenderTransform>
                <ScaleTransform x:Name="DashboardScale" ScaleX="1" ScaleY="1"/>
            </Grid.RenderTransform>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- 0: Header -->
                <RowDefinition Height="*"/>    <!-- 1: Spectrum -->
                <RowDefinition Height="Auto"/> <!-- 2: Stats Row -->
                <RowDefinition Height="Auto"/> <!-- 3: Button rows -->
                <RowDefinition Height="Auto"/> <!-- 4: Indicators Footer -->
            </Grid.RowDefinitions>

            <!-- 0: Header. Tap = logo toggle; press-and-hold / right-click = settings. -->
            <ctrl:LogoBadge x:Name="HeaderLogo"
                           AutomationProperties.AutomationId="HeaderLogo"
                           MaxWidth="600"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Top"
                           RightTapped="HeaderLogo_RightTapped"
                           Opacity="0"
                           RenderTransformOrigin="0.5,0.5">
                <ctrl:LogoBadge.RenderTransform>
                    <TranslateTransform x:Name="HeaderLogoTransform" Y="20"/>
                </ctrl:LogoBadge.RenderTransform>
            </ctrl:LogoBadge>

            <!-- 1: Spectrum View + Now Playing Card (overlay in same cell) -->
            <Grid x:Name="SpectrumArea"
                  AutomationProperties.AutomationId="SpectrumArea"
                  Grid.Row="1"
                  MinHeight="120"
                  Margin="0,2,0,0"
                  Background="Transparent"
                  Tapped="SpectrumArea_Tapped"
                  Opacity="0"
                  RenderTransformOrigin="0.5,0.5">
                <Grid.RenderTransform>
                    <TranslateTransform x:Name="SpectrumTransform" Y="20"/>
                </Grid.RenderTransform>
                <ctrl:SpectrumView x:Name="SpectrumView"/>
                <ctrl:NowPlayingCard x:Name="NowPlayingCard"/>

                <!-- Unified left/right edge fades for the whole spectrum-area cell
                     (spectrum + NowPlaying card). Background colour at the edge →
                     transparent ~80px inward; eased stops, since a linear alpha ramp
                     reads as a hard "kink" next to bright content. Stop colours are
                     set from the theme in code-behind. IsHitTestVisible=False so taps
                     still reach the card/spectrum beneath. -->
                <Rectangle Width="80" HorizontalAlignment="Left" IsHitTestVisible="False">
                    <Rectangle.Fill>
                        <LinearGradientBrush x:Name="LeftEdgeFade" StartPoint="0,0.5" EndPoint="1,0.5">
                            <GradientStop Offset="0.0"/>
                            <GradientStop Offset="0.18"/>
                            <GradientStop Offset="0.42"/>
                            <GradientStop Offset="0.66"/>
                            <GradientStop Offset="0.85"/>
                            <GradientStop Offset="1.0"/>
                        </LinearGradientBrush>
                    </Rectangle.Fill>
                </Rectangle>
                <Rectangle Width="80" HorizontalAlignment="Right" IsHitTestVisible="False">
                    <Rectangle.Fill>
                        <LinearGradientBrush x:Name="RightEdgeFade" StartPoint="1,0.5" EndPoint="0,0.5">
                            <GradientStop Offset="0.0"/>
                            <GradientStop Offset="0.18"/>
                            <GradientStop Offset="0.42"/>
                            <GradientStop Offset="0.66"/>
                            <GradientStop Offset="0.85"/>
                            <GradientStop Offset="1.0"/>
                        </LinearGradientBrush>
                    </Rectangle.Fill>
                </Rectangle>
            </Grid>

            <!-- 2: Stats Row (StatPairs generated from config) -->
            <StackPanel x:Name="StatsRow"
                        Grid.Row="2"
                        Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        Spacing="50"
                        Margin="0,4,0,34"
                        Opacity="0"
                        RenderTransformOrigin="0.5,0.5">
                <StackPanel.RenderTransform>
                    <TranslateTransform x:Name="StatsTransform" Y="20"/>
                </StackPanel.RenderTransform>
            </StackPanel>

            <!-- 3: Button rows (generated from config; each row animates in on its own) -->
            <StackPanel x:Name="ButtonRows"
                        Grid.Row="3"
                        Spacing="24"
                        Margin="0,15,0,28"/>

            <!-- 4: Indicators Footer -->
            <Grid x:Name="IndicatorsFooter"
                  Grid.Row="4"
                  MinHeight="45"
                  Opacity="0"
                  RenderTransformOrigin="0.5,0.5">
                <Grid.RenderTransform>
                    <TranslateTransform x:Name="IndicatorsTransform" Y="20"/>
                </Grid.RenderTransform>
                <!-- Margin="0,0,0,-15": the dot rows and their labels deliberately
                     render into the bottom 40 px padding band. -->
                <StackPanel x:Name="ActivityRows"
                            Orientation="Horizontal" Spacing="40"
                            VerticalAlignment="Bottom" HorizontalAlignment="Left"
                            Margin="0,0,0,-15"/>

                <ctrl:InputDotBar x:Name="InputDots" HorizontalAlignment="Center" VerticalAlignment="Bottom"
                                  Margin="0,0,0,-15"/>

                <!-- Power button, bottom-right: its right and bottom edges sit on the
                     40 px content padding. -->
                <Button x:Name="PowerBtn"
                        AutomationProperties.AutomationId="PowerBtn"
                        AutomationProperties.Name="Power"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Bottom"
                        Width="45" Height="45"
                        CornerRadius="22.5"
                        Background="{StaticResource BtnPlayingBrush}"
                        Click="PowerBtn_Click"
                        Padding="0">
                    <Viewbox Width="22" Height="22">
                        <Path Data="M12,2L12,12M5.07,5.07A10,10,0,1,0,18.93,5.07"
                              Stroke="Black" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                    </Viewbox>
                </Button>
            </Grid>
        </Grid>

        <!-- Edge glow while the logo toggle is on. MasterGlow.Opacity tracks the
             configured level address so the frame pulses with the music. The colour
             cycles through the theme and the horizontal (top+bottom) and vertical
             (left+right) pairs sweep brightness + bloom out of phase — see
             UpdatePartyGlow(). Edge-anchored ScaleTransforms let each band grow
             inward at its peak without moving the lit edge. -->
        <Grid x:Name="MasterGlow" IsHitTestVisible="False" Opacity="0">
            <Grid x:Name="GlowHorizontal">
                <Rectangle VerticalAlignment="Top" Height="90" RenderTransformOrigin="0.5,0">
                    <Rectangle.RenderTransform>
                        <ScaleTransform x:Name="TopScale"/>
                    </Rectangle.RenderTransform>
                    <Rectangle.Fill>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop x:Name="TopSolid" Offset="0.0"/>
                            <GradientStop x:Name="TopFade"  Offset="1.0"/>
                        </LinearGradientBrush>
                    </Rectangle.Fill>
                </Rectangle>
                <Rectangle VerticalAlignment="Bottom" Height="90" RenderTransformOrigin="0.5,1">
                    <Rectangle.RenderTransform>
                        <ScaleTransform x:Name="BottomScale"/>
                    </Rectangle.RenderTransform>
                    <Rectangle.Fill>
                        <LinearGradientBrush StartPoint="0,1" EndPoint="0,0">
                            <GradientStop x:Name="BottomSolid" Offset="0.0"/>
                            <GradientStop x:Name="BottomFade"  Offset="1.0"/>
                        </LinearGradientBrush>
                    </Rectangle.Fill>
                </Rectangle>
            </Grid>
            <Grid x:Name="GlowVertical">
                <Rectangle HorizontalAlignment="Left" Width="90" RenderTransformOrigin="0,0.5">
                    <Rectangle.RenderTransform>
                        <ScaleTransform x:Name="LeftScale"/>
                    </Rectangle.RenderTransform>
                    <Rectangle.Fill>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop x:Name="LeftSolid" Offset="0.0"/>
                            <GradientStop x:Name="LeftFade"  Offset="1.0"/>
                        </LinearGradientBrush>
                    </Rectangle.Fill>
                </Rectangle>
                <Rectangle HorizontalAlignment="Right" Width="90" RenderTransformOrigin="1,0.5">
                    <Rectangle.RenderTransform>
                        <ScaleTransform x:Name="RightScale"/>
                    </Rectangle.RenderTransform>
                    <Rectangle.Fill>
                        <LinearGradientBrush StartPoint="1,0" EndPoint="0,0">
                            <GradientStop x:Name="RightSolid" Offset="0.0"/>
                            <GradientStop x:Name="RightFade"  Offset="1.0"/>
                        </LinearGradientBrush>
                    </Rectangle.Fill>
                </Rectangle>
            </Grid>
        </Grid>

        <!-- Overlays — z-order: HUD → Power → Shutdown (topmost) -->
        <ctrl:OverlayHud x:Name="HudOverlay" Opacity="0" IsHitTestVisible="False"/>
        <ctrl:PowerOverlay x:Name="PowerOverlayControl" Opacity="0" IsHitTestVisible="False"
                           ShutdownClicked="PowerOverlay_ShutdownClicked"
                           RestartClicked="PowerOverlay_RestartClicked"
                           DisplayOffClicked="PowerOverlay_DisplayOffClicked"/>
        <ctrl:ShutdownOverlay x:Name="ShutdownOverlayControl" Opacity="0" IsHitTestVisible="False"/>
    </Grid>
    </Viewbox>
</Page>
