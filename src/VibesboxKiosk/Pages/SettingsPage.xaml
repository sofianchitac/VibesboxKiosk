<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="VibesboxKiosk.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    RequestedTheme="Dark"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- A plain list + form instead of NavigationView: its content area mis-sized
             at some window widths and clipped the right-hand controls. -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <ListView x:Name="Nav" Padding="0,12,0,0" SelectionMode="Single"
                      SelectionChanged="Nav_SelectionChanged"
                      AutomationProperties.Name="Settings sections"/>
            <ScrollViewer x:Name="ContentScroll" Grid.Column="1" Padding="32,24,32,32"
                          Background="{ThemeResource LayerFillColorDefaultBrush}">
                <!-- Star column capped at 900: the form fills narrow windows and stays
                     left-aligned at 900 wide on large ones. -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" MaxWidth="900"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel x:Name="Form" Spacing="8"/>
                </Grid>
            </ScrollViewer>
        </Grid>

        <!-- Command bar: the page is modal, so Save / Cancel are always visible. -->
        <Grid Grid.Row="1" Padding="24,12" ColumnSpacing="12"
              Background="{ThemeResource LayerFillColorDefaultBrush}"
              BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,1,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="PathText" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                       Style="{StaticResource CaptionTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            <Button Grid.Column="1" Content="Quit kiosk" Click="Quit_Click"
                    AutomationProperties.AutomationId="SettingsQuit"/>
            <Button Grid.Column="2" Content="Cancel" Click="Cancel_Click"
                    AutomationProperties.AutomationId="SettingsCancel"/>
            <Button Grid.Column="3" Content="Save" Click="Save_Click" Style="{StaticResource AccentButtonStyle}"
                    AutomationProperties.AutomationId="SettingsSave"/>
        </Grid>
    </Grid>
</Page>
